# ====================================================================
# QR Attendance System - Environment Variables
# ====================================================================

# Port for local Express server
PORT=3000

# Secret key used for signing JWT tokens
JWT_SECRET=qr-attendance-secret-key-grade6-2026

# Supabase PostgreSQL Database Connection String
# Get this from Supabase Dashboard -> Project Settings -> Database -> Connection String (URI)
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# (If left empty, the server automatically falls back to local SQLite attendance.db)
DATABASE_URL=

# SMS Notification Provider (twilio, semaphore, or mock)
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=your_twilio_phone_number_here
SEMAPHORE_API_KEY=your_semaphore_api_key_here
